' ════════════════════════════════════════════════════════════════════
' GAME MODES & PROGRESSION
' ════════════════════════════════════════════════════════════════════
abstract class Mode {
  # playerCharName : String
  # enemyQueue : List<String>
  # queueIndex : int
  # {static} ALL_CHARACTERS : String[]
  --
  # buildEnemyQueue()
  # getNextEnemyName() : String
  # getCurrentEnemyName() : String
  + getPlayerCharName() : String
  + {abstract} onMatchWon()
  + {abstract} onMatchLost()
  + {abstract} isRunOver() : boolean
  + {abstract} getHUDLabel() : String
}

class ArcadeMode extends Mode {
  - {static} TOTAL_STAGES : int = 8
  - {static} FINAL_BOSSES : String[]
  - currentStage : int
  - stageEnemies : List<String>
  - runOver : boolean
  - playerDefeated : boolean
  --
  - buildStageEnemies()
  + onMatchWon()
  + onMatchLost()
  + isRunOver() : boolean
  + getHUDLabel() : String
  + getCurrentStageName() : String
  + isFinalStage() : boolean
  + getStagesCleared() : int
}

class EndlessMode extends Mode {
  - winStreak : int
  --
  + onMatchWon()
  + onMatchLost()
  + isRunOver() : boolean
  + getHUDLabel() : String
  + getCurrentOpponent() : String
  + nextOpponent() : String
  + getWinStreak() : int
}

class PVCMode {
  + {static} chooseSkill(enemy : Character, enemyCD : int[]) : int
}

class PVPMode {
  ' Placeholder for future PVP-specific rules
}

' ════════════════════════════════════════════════════════════════════
' CHARACTERS & SKILLS
' ════════════════════════════════════════════════════════════════════
abstract class Character {
  # name : String
  # maxHP : int
  # currentHP : int
  # maxMana : int
  # currentMana : int
  # skills : List<Skill>
  --
  + getName() : String
  + getHealth() : int
  + getCurrentMana() : int
  + getSkills() : List<Skill>
  + takeDamage(amount : int)
  + addMana(amount : int)
  + restoreHP()
  + restoreMana()
  + isAlive() : boolean
}

