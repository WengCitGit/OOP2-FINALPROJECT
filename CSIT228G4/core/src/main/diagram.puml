@startuml FastFeud_System_Complete
skinparam classAttributeIconSize 0
skinparam backgroundColor #FAFAFA

' ════════════════════════════════════════════════════════════════════
' CORE APPLICATION
' ════════════════════════════════════════════════════════════════════
class Main extends Game {
  - bgm : Music
  + create()
  + dispose()
}

class DesktopLauncher {
  + main(args : String[])
}

abstract class Game

' ════════════════════════════════════════════════════════════════════
' INTERFACES & BASE CLASSES
' ════════════════════════════════════════════════════════════════════
interface Screen {
  + render(delta : float)
  + resize(width : int, height : int)
  + show()
  + hide()
  + pause()
  + resume()
  + dispose()
}

abstract class BaseBattleScreen implements Screen {
  # game : Game
  # username : String
  # player2Name : String
  # batch : SpriteBatch
  # camera : OrthographicCamera
  # player : Character
  # enemy : Character
  # currentRound : int
  # playerWins : int
  # enemyWins : int
  # isPlayerTurn : boolean
  # matchIsOver : boolean
  --
  # executeSkill(index : int)
  # endOfRound()
  # checkMatchState()
  # resetRound()
  + render(delta : float)
  # {abstract} isPVPMode() : boolean
  # {abstract} executeEnemyTurn()
  # {abstract} onMatchOver(playerWon : boolean)
  + dispose()
}

